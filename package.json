{
    "name": "skanic-motion-v2-1",
    "version": "1.0.0",
    "description": "A blank template to get started with Payload 3.0",
    "license": "MIT",
    "type": "module",
    "scripts": {
        "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
        "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --turbopack",
        "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev --turbopack",
        "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
        "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
        "lint": "cross-env NODE_OPTIONS=--no-deprecation biome check .",
        "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation biome check . --write",
        "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
        "start": "cross-env NODE_OPTIONS=--no-deprecation next start"
    },
    "dependencies": {
        "@icons-pack/react-simple-icons": "^12.8.0",
        "@payloadcms/db-postgres": "3.39.1",
        "@payloadcms/next": "3.39.1",
        "@payloadcms/payload-cloud": "3.39.1",
        "@payloadcms/plugin-seo": "3.39.1",
        "@payloadcms/richtext-lexical": "3.39.1",
        "@payloadcms/ui": "3.39.1",
        "@radix-ui/react-slot": "^1.2.2",
        "@tailwindcss/postcss": "^4.1.6",
        "blurhash-base64": "^0.0.3",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cross-env": "^7.0.3",
        "embla-carousel-react": "^8.6.0",
        "graphql": "^16.8.1",
        "lucide-react": "^0.509.0",
        "lucide-static": "^0.511.0",
        "next": "15.3.0",
        "payload": "3.39.1",
        "payload-blurhash-plugin": "^3.1.0",
        "payload-lexical-typography": "^0.4.0",
        "postcss": "^8.5.3",
        "react": "19.1.0",
        "react-dom": "19.1.0",
        "react-window": "^1.8.11",
        "sharp": "0.32.6",
        "tailwind-merge": "^3.2.0",
        "tailwindcss": "^4.1.6",
        "zustand": "^5.0.4"
    },
    "devDependencies": {
        "@biomejs/biome": "2.0.0-beta.5",
        "@tailwindcss/typography": "^0.5.16",
        "@types/node": "^22.5.4",
        "@types/react": "19.1.0",
        "@types/react-dom": "19.1.2",
        "ts-plugin-sort-import-suggestions": "^1.0.4",
        "tw-animate-css": "^1.2.9",
        "typescript": "5.7.3"
    },
    "engines": {
        "node": "^18.20.2 || >=20.9.0",
        "pnpm": "^9 || ^10"
    },
    "pnpm": {
        "onlyBuiltDependencies": ["sharp"]
    }
}
